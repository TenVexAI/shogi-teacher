# Shogi Teacher Connection Server - Environment Variables

# =============================================================================
# Server Configuration
# =============================================================================

# Secret key for JWT signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SERVER_SECRET_KEY=your-secure-random-string-here

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://shogi.tenvexai.com,http://localhost:3000

# Enable debug mode (shows /admin/stats endpoint)
DEBUG=false

# =============================================================================
# Twitch OAuth
# =============================================================================
# Register at: https://dev.twitch.tv/console

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://shogi.tenvexai.com/auth/twitch/callback

# =============================================================================
# Discord OAuth
# =============================================================================
# Register at: https://discord.com/developers/applications

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://shogi.tenvexai.com/auth/discord/callback

# =============================================================================
# GitHub OAuth
# =============================================================================
# Register at: https://github.com/settings/developers

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://shogi.tenvexai.com/auth/github/callback
